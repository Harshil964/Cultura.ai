# --- Database ---
# Local Postgres. If unset, the app falls back to a local SQLite file
# (sqlite:///./cultura.db) so you can run the MVP with zero setup.
DATABASE_URL=postgresql+psycopg2://cultura:cultura@localhost:5432/cultura

# --- Image generation (Visual Studio, later milestone) ---
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
