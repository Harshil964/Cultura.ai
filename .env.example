# --- LLM provider ---
# One of: openai, gemini, groq
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Database ---
# Local Postgres. If unset, the app falls back to a local SQLite file
# (sqlite:///./cultura.db) so you can run the MVP with zero setup.
DATABASE_URL=postgresql+psycopg2://cultura:cultura@localhost:5432/cultura
#DATABASE_URL="postgresql://trip_memory_mgyu_user:IqMZc7UAyVgGKUoav9g8o5HPFnmNLl50@dpg-dann2h6gekts739gn4rg-a.oregon-postgres.render.com/trip_memory_mgyusslmode=require"

# --- Image generation (Visual Studio, later milestone) ---
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
